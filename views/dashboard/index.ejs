<!-- JAVASCRIPT EDIT JAM -->

<!-- ====================================================== -->

<script>

  document.addEventListener(
    "DOMContentLoaded",
    function () {
  
  
      // ==================================================
      // ELEMENT
      // ==================================================
  
      const modalElement =
        document.getElementById(
          "modalEditJam"
        );
  
  
      const modal =
        new bootstrap.Modal(
          modalElement
        );
  
  
      const inputId =
        document.getElementById(
          "edit_id_presensi"
        );
  
  
      const inputJamLama =
        document.getElementById(
          "edit_jam_lama"
        );
  
  
      const inputTanggal =
        document.getElementById(
          "edit_tanggal"
        );
  
  
      const inputJam =
        document.getElementById(
          "edit_jam"
        );
  
  
      const inputStatus =
        document.getElementById(
          "edit_status"
        );
  
  
      const btnSimpan =
        document.getElementById(
          "btnSimpanJam"
        );
  
  
      // ==================================================
      // TOMBOL EDIT
      // ==================================================
  
      document
        .querySelectorAll(".btn-edit-jam")
        .forEach(function (button) {
  
  
          button.addEventListener(
            "click",
            function () {
  
  
              // ==========================================
              // AMBIL DATA
              // ==========================================
  
              const id =
                this.getAttribute(
                  "data-id"
                );
  
  
              const jamLama =
                this.getAttribute(
                  "data-jam"
                );
  
  
              const status =
                this.getAttribute(
                  "data-status"
                );
  
  
              console.log(
                "================================"
              );
  
              console.log(
                "EDIT PRESENSI"
              );
  
              console.log(
                "ID:",
                id
              );
  
              console.log(
                "Jam Lama:",
                jamLama
              );
  
              console.log(
                "Status:",
                status
              );
  
  
              // ==========================================
              // VALIDASI
              // ==========================================
  
              if (!id) {
  
                alert(
                  "ID pegawai tidak ditemukan."
                );
  
                return;
  
              }
  
  
              if (!jamLama) {
  
                alert(
                  "Jam datang tidak ditemukan."
                );
  
                return;
  
              }
  
  
              // ==========================================
              // AMBIL TANGGAL
              // ==========================================
  
              const tanggal =
                jamLama.substring(
                  0,
                  10
                );
  
  
              // ==========================================
              // AMBIL JAM
              // ==========================================
  
              const jam =
                jamLama.substring(
                  11,
                  16
                );
  
  
              // ==========================================
              // ISI FORM
              // ==========================================
  
              inputId.value =
                id;
  
  
              inputJamLama.value =
                jamLama;
  
  
              inputTanggal.value =
                tanggal;
  
  
              inputJam.value =
                jam;
  
  
              inputStatus.value =
                status;
  
  
              console.log(
                "Tanggal:",
                tanggal
              );
  
              console.log(
                "Jam:",
                jam
              );
  
              console.log(
                "Status:",
                status
              );
  
  
              // ==========================================
              // TAMPILKAN MODAL
              // ==========================================
  
              modal.show();
  
            }
  
          );
  
        });
  
  
      // ==================================================
      // SIMPAN PERUBAHAN
      // ==================================================
  
      btnSimpan.addEventListener(
        "click",
        async function () {
  
  
          const id =
            inputId.value.trim();
  
  
          const jamLama =
            inputJamLama.value.trim();
  
  
          const tanggal =
            inputTanggal.value.trim();
  
  
          const jam =
            inputJam.value.trim();
  
  
          const status =
            inputStatus.value.trim();
  
  
          console.log(
            "================================"
          );
  
          console.log(
            "SIMPAN PERUBAHAN"
          );
  
          console.log(
            "ID:",
            id
          );
  
          console.log(
            "Jam Lama:",
            jamLama
          );
  
          console.log(
            "Tanggal:",
            tanggal
          );
  
          console.log(
            "Jam Baru:",
            jam
          );
  
          console.log(
            "Status:",
            status
          );
  
  
          // ==================================================
          // VALIDASI
          // ==================================================
  
          if (!id) {
  
            alert(
              "ID pegawai belum tersedia."
            );
  
            return;
  
          }
  
  
          if (!jamLama) {
  
            alert(
              "Data jam lama belum tersedia."
            );
  
            return;
  
          }
  
  
          if (!tanggal) {
  
            alert(
              "Tanggal presensi belum tersedia."
            );
  
            return;
  
          }
  
  
          if (!jam) {
  
            alert(
              "Silakan pilih jam datang."
            );
  
            inputJam.focus();
  
            return;
  
          }
  
  
          if (!status) {
  
            alert(
              "Silakan pilih status presensi."
            );
  
            inputStatus.focus();
  
            return;
  
          }
  
  
          // ==================================================
          // BUAT DATETIME BARU
          // ==================================================
  
          const jamBaru =
            `${tanggal} ${jam}:00`;
  
  
          console.log(
            "Datetime Baru:",
            jamBaru
          );
  
  
          // ==================================================
          // DISABLE BUTTON
          // ==================================================
  
          btnSimpan.disabled =
            true;
  
  
          btnSimpan.innerHTML =
            '<i class="fas fa-spinner fa-spin me-1"></i> Menyimpan...';
  
  
          try {
  
  
            // ==================================================
            // REQUEST SERVER
            // ==================================================
  
            const response =
              await fetch(
                "/dashboard/presensi/update",
                {
  
                  method: "POST",
  
                  headers: {
  
                    "Content-Type":
                      "application/json",
  
                    "Accept":
                      "application/json"
  
                  },
  
                  body:
                    JSON.stringify({
  
                      id:
                        id,
  
                      jam_lama:
                        jamLama,
  
                      jam_datang:
                        jamBaru,
  
                      status:
                        status
  
                    })
  
                }
              );
  
  
            // ==================================================
            // RESPONSE
            // ==================================================
  
            const result =
              await response.json();
  
  
            console.log(
              "HTTP Status:",
              response.status
            );
  
  
            console.log(
              "Response:",
              result
            );
  
  
            // ==================================================
            // BERHASIL
            // ==================================================
  
            if (
              response.ok &&
              result.success
            ) {
  
  
              alert(
                "✅ " +
                result.message
              );
  
  
              modal.hide();
  
  
              // Refresh dashboard
  
              window.location.reload();
  
            }
  
  
            // ==================================================
            // GAGAL
            // ==================================================
  
            else {
  
  
              alert(
                "⚠️ " +
                (
                  result.message ||
                  "Gagal memperbarui data."
                )
              );
  
            }
  
  
          } catch (error) {
  
  
            console.error(
              "Update Error:",
              error
            );
  
  
            alert(
              "❌ Terjadi kesalahan koneksi ke server."
            );
  
  
          } finally {
  
  
            btnSimpan.disabled =
              false;
  
  
            btnSimpan.innerHTML =
              '<i class="fas fa-save me-1"></i> Simpan Perubahan';
  
          }
  
        }
  
      );
  
    }
  
  );
  
  </script>

