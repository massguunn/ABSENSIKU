<script>

function updateWaktu() {


  const sekarang =
    new Date();


  // ==================================================
  // TANGGAL
  // ==================================================

  const tanggal =
    sekarang.toLocaleDateString(
      "id-ID",
      {

        weekday: "long",

        year: "numeric",

        month: "long",

        day: "numeric"

      }
    );


  // ==================================================
  // JAM
  // ==================================================

  const jam =
    sekarang.toLocaleTimeString(
      "id-ID",
      {

        hour: "2-digit",

        minute: "2-digit",

        second: "2-digit"

      }
    );


  // ==================================================
  // TAMPILKAN
  // ==================================================

  const tanggalElement =
    document.getElementById(
      "tanggalHariIni"
    );


  const jamElement =
    document.getElementById(
      "jamSekarang"
    );


  if (tanggalElement) {

    tanggalElement.textContent =
      tanggal;

  }


  if (jamElement) {

    jamElement.textContent =
      jam;

  }

}


// Jalankan pertama kali

updateWaktu();


// Update setiap 1 detik

setInterval(
  updateWaktu,
  1000
);

</script>
