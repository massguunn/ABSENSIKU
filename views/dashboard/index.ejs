<!-- BODY FILTER -->

<div class="card-body">

  <form
    action="/dashboard"
    method="GET"
  >

    <div class="row g-3 align-items-end">


      <!-- ID PEGAWAI -->

      <div class="col-md-4">

        <label class="form-label">
          ID Pegawai
        </label>

        <select
          name="id_pegawai"
          class="form-select"
        >

          <option value="">
            -- Semua Pegawai --
          </option>


          <% if (pegawai && pegawai.length > 0) { %>

            <% pegawai.forEach(item => { %>

              <option
                value="<%= item.id_pegawai %>"
                <%= String(selectedId || "") === String(item.id_pegawai) ? "selected" : "" %>
              >

                <%= item.id_pegawai %> -
                <%= item.nama %>

              </option>

            <% }) %>

          <% } %>

        </select>

      </div>


      <!-- TANGGAL MULAI -->

      <div class="col-md-3">

        <label class="form-label">
          Tanggal Mulai
        </label>

        <input
          type="date"
          name="tanggal_mulai"
          class="form-control"
          value="<%= tanggalMulai || '' %>"
        >

      </div>


      <!-- TANGGAL SAMPAI -->

      <div class="col-md-3">

        <label class="form-label">
          Tanggal Sampai
        </label>

        <input
          type="date"
          name="tanggal_sampai"
          class="form-control"
          value="<%= tanggalSampai || '' %>"
        >

      </div>


      <!-- BUTTON -->

      <div class="col-md-2">

        <button
          type="submit"
          class="btn btn-primary w-100"
        >

          <i class="fas fa-search me-1"></i>

          Tampilkan

        </button>

      </div>

    </div>

  </form>

</div>

