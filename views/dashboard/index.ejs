<div class="card-body">

  <div class="table-responsive">

    <table
      class="table table-hover table-bordered align-middle mb-0"
    >

      <!-- HEADER TABEL -->

      <thead class="table-primary text-center">

        <tr>

          <th width="60">
            No
          </th>

          <th>
            ID Pegawai
          </th>

          <th>
            Nama Pegawai
          </th>

          <th>
            Departemen
          </th>

          <th>
            Shift
          </th>

          <th>
            Tanggal
          </th>

          <th>
            Jam Datang
          </th>

          <th>
            Jam Pulang
          </th>

          <th>
            Status
          </th>

          <th width="80">
            Aksi
          </th>

        </tr>

      </thead>


      <!-- BODY TABEL -->

      <tbody>


        <% if (presensiHariIni && presensiHariIni.length > 0) { %>


          <% presensiHariIni.forEach((item, index) => { %>

            <tr>


              <!-- NOMOR -->

              <td class="text-center">

                <%= index + 1 %>

              </td>


              <!-- ID PEGAWAI -->

              <td class="text-center fw-semibold">

                <%= item.id_pegawai %>

              </td>


              <!-- NAMA -->

              <td>

                <%= item.nama %>

              </td>


              <!-- DEPARTEMEN -->

              <td>

                <%= item.departemen || "-" %>

              </td>


              <!-- SHIFT -->

              <td class="text-center">

                <%= item.shift || "-" %>

              </td>


              <!-- ================================================= -->
              <!-- TANGGAL -->
              <!-- ================================================= -->

              <td class="text-center">

                <% if (item.jam_datang) { %>

                  <%= new Date(item.jam_datang).toLocaleDateString(
                    "id-ID",
                    {
                      day: "2-digit",
                      month: "2-digit",
                      year: "numeric"
                    }
                  ) %>

                <% } else { %>

                  -

                <% } %>

              </td>


              <!-- ================================================= -->
              <!-- JAM DATANG -->
              <!-- ================================================= -->

              <td class="text-center">

                <% if (item.jam_datang) { %>

                  <span class="badge bg-success">

                    <i class="fas fa-sign-in-alt me-1"></i>

                    <%= new Date(item.jam_datang).toLocaleTimeString(
                      "id-ID",
                      {
                        hour: "2-digit",
                        minute: "2-digit"
                      }
                    ) %>

                  </span>

                <% } else { %>

                  <span class="text-muted">
                    -
                  </span>

                <% } %>

              </td>


              <!-- ================================================= -->
              <!-- JAM PULANG -->
              <!-- ================================================= -->

              <td class="text-center">

                <% if (item.jam_pulang) { %>

                  <span class="badge bg-info text-dark">

                    <i class="fas fa-sign-out-alt me-1"></i>

                    <%= new Date(item.jam_pulang).toLocaleTimeString(
                      "id-ID",
                      {
                        hour: "2-digit",
                        minute: "2-digit"
                      }
                    ) %>

                  </span>

                <% } else { %>

                  <span class="text-muted">
                    Belum Pulang
                  </span>

                <% } %>

              </td>


              <!-- ================================================= -->
              <!-- STATUS -->
              <!-- ================================================= -->

              <td class="text-center">

                <%
                  const status =
                    (item.status || "")
                    .toLowerCase()
                    .trim();
                %>


                <% if (
                  status === "hadir" ||
                  status.includes("tepat waktu")
                ) { %>

                  <span
                    class="badge rounded-pill bg-success px-3 py-2"
                  >

                    <i class="fas fa-check-circle me-1"></i>

                    <%= item.status %>

                  </span>


                <% } else if (
                  status.includes("terlambat")
                ) { %>

                  <span
                    class="badge rounded-pill bg-warning text-dark px-3 py-2"
                  >

                    <i class="fas fa-clock me-1"></i>

                    <%= item.status %>

                  </span>


                <% } else { %>

                  <span
                    class="badge rounded-pill bg-danger px-3 py-2"
                  >

                    <i class="fas fa-times-circle me-1"></i>

                    <%= item.status || "Tidak Hadir" %>

                  </span>

                <% } %>

              </td>


              <!-- ================================================= -->
              <!-- AKSI EDIT -->
              <!-- ================================================= -->

              <td class="text-center">

                <% if (item.jam_datang) { %>

                  <button
                  type="button"
                  class="btn btn-sm btn-outline-primary btn-edit-jam"
                
                  data-id="<%= item.id_pegawai %>"
                
                  data-jam="<%= item.jam_datang %>"
                
                  data-status="<%= item.status || '' %>"
                
                  title="Edit Presensi"
                >
                
                  <i class="fas fa-edit"></i>
                
                </button>

                <% } else { %>

                  <span class="text-muted">
                    -
                  </span>

                <% } %>

              </td>

            </tr>

          <% }) %>


        <% } else { %>


          <!-- ================================================= -->
          <!-- DATA KOSONG -->
          <!-- ================================================= -->

          <tr>

            <td
              colspan="10"
              class="text-center py-5"
            >

              <div class="text-muted">

                <i
                  class="fas fa-calendar-times fa-3x mb-3"
                ></i>

                <h6>
                  Tidak Ada Data Presensi
                </h6>

                <p class="mb-0">

                  Belum terdapat data presensi
                  untuk filter yang dipilih.

                </p>

              </div>

            </td>

          </tr>


        <% } %>

      </tbody>

    </table>

  </div>

</div>
